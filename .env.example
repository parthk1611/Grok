# Copy to .env for local runs (never commit .env). There are NO real secrets here and none are needed today.
RELAY_DATA_MODE=mock            # mock | live (live is not implemented yet and refuses to start)
RELAY_MOCK_SCENARIO=fresh       # fresh | stale | expired | no_cache  (demo of the staleness levels / 503 path)
RELAY_HOST=127.0.0.1            # loopback by default; the container sets 0.0.0.0 and compose publishes 127.0.0.1 only
RELAY_PORT=8000
RELAY_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
RELAY_VALIDATE_RESPONSES=true   # fail closed on schema-invalid payloads
RELAY_SPREAD_TIMEOUT_S=60       # synchronous spread run limit
RELAY_CORS_ORIGINS=             # comma-separated explicit origins, e.g. http://localhost:5173 (empty = none)
# RELAY_CONTRACTS_DIR=./contracts
